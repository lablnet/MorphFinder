{
  "name": "MorphFinder",
  "productName": "MorphFinder",
  "version": "1.0.3",
  "description": "Multi-platform file manager with a runtime-switchable Finder/Explorer/Dolphin Tri-UI shell.",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Lablnet",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --build tsconfig.node.json tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:native": "node tests/native/smoke.mjs",
    "test:e2e": "pnpm build && playwright test",
    "preview": "electron-vite preview",
    "build:mac": "pnpm native:build && pnpm build && electron-builder --mac",
    "build:mas": "pnpm native:build && pnpm build && electron-builder --mac mas",
    "build:win": "pnpm native:build && pnpm build && electron-builder --win",
    "build:linux": "pnpm native:build && pnpm build && electron-builder --linux",
    "native:build": "node native/build.mjs",
    "release": "pnpm build && electron-builder",
    "build:assets": "tsx scripts/build-assets.ts",
    "fix:screenshots": "tsx scripts/fix-screenshot-dimensions.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lablnet/MorphFinder.git"
  },
  "dependencies": {
    "@lablnet/ui": "^1.0.1",
    "@parcel/watcher": "^2.5.1",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.11",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^29.1.1",
    "node-swift": "1.5.1",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "tar": "^7.5.19",
    "vite": "^6.4.3",
    "esbuild": ">=0.25.0",
    "dompurify": "^3.4.12",
    "electron": "^44.4.5"
  }
}
